---
import BaseLayout from '../layouts/BaseLayout.astro';
import items from '../data/items.json';
import constants from '../data/constants.json';
import { ORDEM_SLOT as slotOrder, slotLabel } from '../lib/labels';

const c = constants as unknown as Record<string, number>;
const itemsBySlot = Object.fromEntries(
  slotOrder.map((slot) => [slot, items.filter((i) => i.slot === slot)])
);
---

<BaseLayout
  title="Calculadora"
  banner="Ferramentas"
  description="Comparador de itens e calculadora de Power Score de Lootborne — ferramentas de apoio, sem automatizar nada dentro do jogo."
>
  <header class="mb-8">
    <p class="text-gold-bright text-sm font-semibold uppercase tracking-wide mb-2">Ferramentas</p>
    <h1 class="font-display text-3xl md:text-4xl font-semibold mb-3">Calculadora de build</h1>
    <p class="text-text-soft max-w-3xl">
      Ferramentas de apoio pra decisão — nada aqui roda dentro do jogo ou automatiza qualquer coisa.
      A fórmula de Power Score é uma <span class="text-gold">interpretação</span> (peso das constantes
      reais do jogo), não uma confirmação 1:1 do código — use como guia comparativo, não como número
      oficial.
    </p>
  </header>

  <section class="panel p-5 mb-8">
    <h2 class="font-display text-xl mb-4">Comparador de item</h2>
    <div class="grid md:grid-cols-2 gap-5">
      <div>
        <label class="text-xs text-text-muted uppercase tracking-wide block mb-1">Slot</label>
        <select id="cmp-slot" class="w-full bg-deep border border-copper rounded-lg px-3 py-2 text-sm mb-3">
          {slotOrder.map((s) => <option value={s}>{slotLabel(s)}</option>)}
        </select>
        <label class="text-xs text-text-muted uppercase tracking-wide block mb-1">Item A</label>
        <select id="cmp-a" class="w-full bg-deep border border-copper rounded-lg px-3 py-2 text-sm mb-3"></select>
        <label class="text-xs text-text-muted uppercase tracking-wide block mb-1">Item B</label>
        <select id="cmp-b" class="w-full bg-deep border border-copper rounded-lg px-3 py-2 text-sm"></select>
      </div>
      <div id="cmp-result" class="text-sm"></div>
    </div>
  </section>

  <section class="panel p-5">
    <h2 class="font-semibold text-lg mb-1">Calculadora de Power Score</h2>
    <p class="text-text-soft text-sm mb-4">
      Some os stats totais do seu personagem (soma dos 6 itens equipados) pra estimar seu PS.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-4">
      {
        ['hp', 'atk', 'def', 'crit', 'parry'].map((stat) => (
          <div>
            <label class="text-xs text-text-muted uppercase block mb-1">{stat}</label>
            <input
              type="number"
              id={`ps-${stat}`}
              value="0"
              class="w-full bg-deep border border-copper rounded-lg px-2 py-1.5 text-sm"
            />
          </div>
        ))
      }
    </div>
    <div id="ps-result" class="text-sm"></div>
  </section>

  <script define:vars={{ itemsBySlot, PS_HP_WEIGHT: c.PS_HP_WEIGHT, PS_ATK_WEIGHT: c.PS_ATK_WEIGHT, PS_DEF_WEIGHT: c.PS_DEF_WEIGHT, PS_CRIT_WEIGHT: c.PS_CRIT_WEIGHT, PS_PARRY_WEIGHT: c.PS_PARRY_WEIGHT, PS_MAX_LEGIT_L60: c.PS_MAX_LEGIT_L60 }}>
    function powerScore(s: { hp: number; atk: number; def: number; crit: number; parry: number }) {
      return (
        s.hp * PS_HP_WEIGHT +
        s.atk * PS_ATK_WEIGHT +
        s.def * PS_DEF_WEIGHT +
        s.crit * PS_CRIT_WEIGHT +
        s.parry * PS_PARRY_WEIGHT
      );
    }

    // --- Comparador de item ---
    const slotSel = document.getElementById('cmp-slot') as HTMLSelectElement;
    const aSel = document.getElementById('cmp-a') as HTMLSelectElement;
    const bSel = document.getElementById('cmp-b') as HTMLSelectElement;
    const result = document.getElementById('cmp-result') as HTMLDivElement;

    function populateItemSelect(sel: HTMLSelectElement, slot: string) {
      const list = (itemsBySlot as Record<string, any[]>)[slot] ?? [];
      sel.innerHTML = list.map((it) => `<option value="${it.id}">${it.namePt} (${it.rarity})</option>`).join('');
    }

    function findItem(slot: string, id: string) {
      return ((itemsBySlot as Record<string, any[]>)[slot] ?? []).find((i) => String(i.id) === id);
    }

    function renderComparison() {
      const slot = slotSel.value;
      const a = findItem(slot, aSel.value);
      const b = findItem(slot, bSel.value);
      if (!a || !b) return;
      const stats = ['hp', 'atk', 'def', 'crit', 'parry'] as const;
      const rows = stats
        .map((s) => {
          const av = a.stats[s] ?? 0;
          const bv = b.stats[s] ?? 0;
          const winner = av === bv ? '' : av > bv ? 'a' : 'b';
          return `<tr>
            <td class="py-1 text-text-muted uppercase text-xs">${s}</td>
            <td class="py-1 text-right ${winner === 'a' ? 'text-gold-bright font-semibold' : ''}">${av}</td>
            <td class="py-1 text-right ${winner === 'b' ? 'text-gold-bright font-semibold' : ''}">${bv}</td>
          </tr>`;
        })
        .join('');
      const psA = powerScore(a.stats);
      const psB = powerScore(b.stats);
      result.innerHTML = `
        <table class="w-full">
          <thead><tr class="text-text-muted text-xs"><th class="text-left font-medium">Stat</th><th class="text-right font-medium">${a.namePt}</th><th class="text-right font-medium">${b.namePt}</th></tr></thead>
          <tbody>${rows}</tbody>
        </table>
        <div class="mt-3 pt-3 border-t border-copper flex justify-between text-xs text-text-soft">
          <span>PS estimado A: <strong class="text-text-main">${psA.toFixed(1)}</strong></span>
          <span>PS estimado B: <strong class="text-text-main">${psB.toFixed(1)}</strong></span>
        </div>
        ${a.effectsPt.length || b.effectsPt.length ? `<div class="mt-3 text-xs text-text-soft space-y-1">
          ${a.effectsPt.length ? `<div><strong class="text-text-main">${a.namePt}:</strong> ${a.effectsPt.join(' · ')}</div>` : ''}
          ${b.effectsPt.length ? `<div><strong class="text-text-main">${b.namePt}:</strong> ${b.effectsPt.join(' · ')}</div>` : ''}
        </div>` : ''}
      `;
    }

    slotSel.addEventListener('change', () => {
      populateItemSelect(aSel, slotSel.value);
      populateItemSelect(bSel, slotSel.value);
      renderComparison();
    });
    aSel.addEventListener('change', renderComparison);
    bSel.addEventListener('change', renderComparison);
    populateItemSelect(aSel, slotSel.value);
    populateItemSelect(bSel, slotSel.value);
    renderComparison();

    // --- Calculadora de PS manual ---
    const psInputs = ['hp', 'atk', 'def', 'crit', 'parry'].map(
      (s) => document.getElementById(`ps-${s}`) as HTMLInputElement
    );
    const psResult = document.getElementById('ps-result') as HTMLDivElement;

    function renderPs() {
      const [hp, atk, def, crit, parry] = psInputs.map((i) => Number(i.value) || 0);
      const ps = powerScore({ hp, atk, def, crit, parry });
      const pct = (ps / PS_MAX_LEGIT_L60) * 100;
      psResult.innerHTML = `
        <div class="text-2xl font-display text-gold-bright">${ps.toFixed(0)}</div>
        <div class="text-text-soft text-xs mt-1">
          ${pct.toFixed(0)}% do teto legítimo de nível 60 (${PS_MAX_LEGIT_L60})
        </div>
      `;
    }
    psInputs.forEach((i) => i.addEventListener('input', renderPs));
    renderPs();
  </script>
</BaseLayout>
