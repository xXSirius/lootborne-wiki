---
import BaseLayout from '../layouts/BaseLayout.astro';
import items from '../data/items.json';
import constants from '../data/constants.json';
import { ORDEM_SLOT, slotLabel, statLabel, rarityLabel } from '../lib/labels';
import { withBase } from '../lib/base';

const c = constants as unknown as Record<string, number>;

const ATRIBUTOS = ['hp', 'atk', 'def', 'crit', 'parry'] as const;

// Enviado pro script do cliente: só o que a comparação precisa, já em pt-BR.
const itemsBySlot = Object.fromEntries(
  ORDEM_SLOT.map((slot) => [
    slot,
    items
      .filter((i) => i.slot === slot)
      .map((i) => ({
        id: i.id,
        nome: i.namePt,
        raridade: rarityLabel(i.rarity),
        stats: i.stats,
        efeitos: i.effectsPt,
      })),
  ])
);

const rotulos = Object.fromEntries(ATRIBUTOS.map((s) => [s, statLabel(s)]));

const pesos = {
  hp: c.PS_HP_WEIGHT,
  atk: c.PS_ATK_WEIGHT,
  def: c.PS_DEF_WEIGHT,
  crit: c.PS_CRIT_WEIGHT,
  parry: c.PS_PARRY_WEIGHT,
};
---

<BaseLayout
  title="Calculadora"
  banner="Ferramentas"
  description="Comparador de itens e calculadora de Power Score de Lootborne — ferramentas de apoio, sem automatizar nada dentro do jogo."
>
  <header class="mb-5">
    <h1 class="page-title mb-2">Calculadora de build</h1>
    <p class="text-text-soft max-w-3xl text-sm leading-relaxed">
      Ferramentas de apoio pra decisão — nada aqui roda dentro do jogo ou automatiza qualquer coisa.
      A fórmula de Power Score é uma <span class="text-gold">interpretação</span> (peso das constantes
      reais do jogo), não uma confirmação 1:1 do código — use como guia comparativo, não como número
      oficial.
    </p>
  </header>

  <section class="panel mb-5">
    <div class="panel-head">
      <img src={withBase('/ui/nav-itens.png')} alt="" width="14" height="14" class="pixel" />
      Comparador de item
    </div>
    <div class="p-4">
      <div class="grid sm:grid-cols-3 gap-3 mb-4">
        <div class="min-w-0">
          <label for="cmp-slot" class="text-[0.65rem] text-gold uppercase tracking-wider block mb-1">
            Slot
          </label>
          <select
            id="cmp-slot"
            class="w-full min-w-0 bg-deep border border-copper px-3 py-2 text-sm rounded-sm focus:outline-none focus:border-gold"
          >
            {ORDEM_SLOT.map((s) => <option value={s}>{slotLabel(s)}</option>)}
          </select>
        </div>
        <div class="min-w-0">
          <label for="cmp-a" class="text-[0.65rem] text-gold uppercase tracking-wider block mb-1">
            Item A
          </label>
          <select
            id="cmp-a"
            class="w-full min-w-0 bg-deep border border-copper px-3 py-2 text-sm rounded-sm focus:outline-none focus:border-gold"
          ></select>
        </div>
        <div class="min-w-0">
          <label for="cmp-b" class="text-[0.65rem] text-gold uppercase tracking-wider block mb-1">
            Item B
          </label>
          <select
            id="cmp-b"
            class="w-full min-w-0 bg-deep border border-copper px-3 py-2 text-sm rounded-sm focus:outline-none focus:border-gold"
          ></select>
        </div>
      </div>
      <div id="cmp-result" class="text-sm"></div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head">
      <img src={withBase('/ui/nav-calculadora.png')} alt="" width="14" height="14" class="pixel" />
      Power Score
    </div>
    <div class="p-4">
      <p class="text-text-soft text-sm mb-4">
        Some os atributos totais do seu personagem (a soma dos 6 itens equipados) pra estimar seu PS.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-4">
        {
          ATRIBUTOS.map((stat) => (
            <div class="min-w-0">
              <label
                for={`ps-${stat}`}
                class="text-[0.65rem] text-gold uppercase tracking-wider block mb-1"
              >
                {statLabel(stat)}
              </label>
              <input
                type="number"
                id={`ps-${stat}`}
                value="0"
                min="0"
                inputmode="numeric"
                class="w-full min-w-0 bg-deep border border-copper px-2 py-1.5 text-sm rounded-sm tabular-nums focus:outline-none focus:border-gold"
              />
            </div>
          ))
        }
      </div>
      <div id="ps-result" class="text-sm"></div>
    </div>
  </section>

  {/* Sem TypeScript aqui dentro: um <script> com atributo (define:vars) é
      tratado como is:inline e vai cru pro navegador, sem transpilar. Foi o que
      quebrava esta página inteira com "SyntaxError: Unexpected token ':'". */}
  <script
    define:vars={{ itemsBySlot, rotulos, pesos, atributos: ATRIBUTOS, tetoL60: c.PS_MAX_LEGIT_L60 }}
  >
    const fmt = (v) => String(Number(Number(v).toFixed(3)));

    function powerScore(s) {
      return atributos.reduce((total, k) => total + (Number(s[k]) || 0) * pesos[k], 0);
    }

    // --- Comparador de item ---
    const slotSel = document.getElementById('cmp-slot');
    const aSel = document.getElementById('cmp-a');
    const bSel = document.getElementById('cmp-b');
    const result = document.getElementById('cmp-result');

    const listaDo = (slot) => itemsBySlot[slot] ?? [];

    function popular(sel, slot, indicePadrao) {
      const lista = listaDo(slot);
      sel.innerHTML = lista
        .map((it) => `<option value="${it.id}">${it.nome} (${it.raridade})</option>`)
        .join('');
      // Abre já com dois itens diferentes, senão a comparação nasce vazia.
      if (lista.length) sel.selectedIndex = Math.min(indicePadrao, lista.length - 1);
    }

    const achar = (slot, id) => listaDo(slot).find((i) => String(i.id) === id);

    function comparar() {
      const slot = slotSel.value;
      const a = achar(slot, aSel.value);
      const b = achar(slot, bSel.value);
      if (!a || !b) {
        result.innerHTML = '';
        return;
      }
      const linhas = atributos
        .map((s) => {
          const av = a.stats[s] ?? 0;
          const bv = b.stats[s] ?? 0;
          const venceA = av > bv ? 'text-gold-bright font-semibold' : '';
          const venceB = bv > av ? 'text-gold-bright font-semibold' : '';
          return `<tr class="border-t border-copper/30">
            <td class="py-1 text-text-muted uppercase text-xs">${rotulos[s]}</td>
            <td class="py-1 text-right tabular-nums ${venceA}">${fmt(av)}</td>
            <td class="py-1 text-right tabular-nums ${venceB}">${fmt(bv)}</td>
          </tr>`;
        })
        .join('');

      const psA = powerScore(a.stats);
      const psB = powerScore(b.stats);
      const melhor = psA === psB ? 'empate' : psA > psB ? a.nome : b.nome;

      const efeitos = [a, b]
        .filter((it) => it.efeitos.length)
        .map(
          (it) =>
            `<div><strong class="text-text-main">${it.nome}:</strong> ${it.efeitos.join(' · ')}</div>`
        )
        .join('');

      result.innerHTML = `
        <div class="overflow-x-auto">
          <table class="w-full min-w-[19rem]">
            <thead>
              <tr class="text-gold text-xs uppercase tracking-wider">
                <th class="text-left font-medium pb-1">Atributo</th>
                <th class="text-right font-medium pb-1">${a.nome}</th>
                <th class="text-right font-medium pb-1">${b.nome}</th>
              </tr>
            </thead>
            <tbody>${linhas}</tbody>
          </table>
        </div>
        <div class="mt-3 pt-3 border-t border-copper grid sm:grid-cols-3 gap-2 text-xs text-text-soft">
          <span>PS de A: <strong class="text-text-main tabular-nums">${psA.toFixed(1)}</strong></span>
          <span>PS de B: <strong class="text-text-main tabular-nums">${psB.toFixed(1)}</strong></span>
          <span class="sm:text-right">Maior PS: <strong class="text-gold-bright">${melhor}</strong></span>
        </div>
        ${efeitos ? `<div class="mt-3 text-xs text-text-soft space-y-1">${efeitos}</div>` : ''}
      `;
    }

    function trocarSlot() {
      popular(aSel, slotSel.value, 0);
      popular(bSel, slotSel.value, 1);
      comparar();
    }

    slotSel.addEventListener('change', trocarSlot);
    aSel.addEventListener('change', comparar);
    bSel.addEventListener('change', comparar);
    trocarSlot();

    // --- Power Score manual ---
    const psInputs = atributos.map((s) => document.getElementById(`ps-${s}`));
    const psResult = document.getElementById('ps-result');

    function renderPs() {
      const valores = {};
      atributos.forEach((s, i) => (valores[s] = Number(psInputs[i].value) || 0));
      const ps = powerScore(valores);
      const pct = (ps / tetoL60) * 100;
      psResult.innerHTML = `
        <div class="text-2xl font-display text-gold-bright tabular-nums">${ps.toFixed(0)}</div>
        <div class="text-text-soft text-xs mt-1">
          ${pct.toFixed(0)}% do teto legítimo de nível 60 (${tetoL60})
        </div>
      `;
    }
    psInputs.forEach((i) => i.addEventListener('input', renderPs));
    renderPs();
  </script>
</BaseLayout>
